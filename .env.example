# Copy to .env.local (never committed). Both are optional: without them the
# flight world plays with no durable layer (nothing built is kept).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where the heavy models and textures are asked first: the Storage bucket's
# public URL (scripts/assets-upload.mjs prints it). Optional: without it every
# file comes from the site. Never put the service-role key here or in any file.
VITE_ASSET_BASE=
