# Copy to .env.local (never committed). Both are optional: the asset mirror reads the URL.
# Without them /fly plays with no durable layer (nothing built is kept). # planet flight
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The Battlefront 2017 drop (scripts/bf2017-fetch.mjs): the project URL and a key that can read the bf2017-assets bucket.
SUPABASE_URL=
BF2017_KEY=
# Where the heavy models and textures are asked first: the Storage bucket's
# public URL (scripts/assets-upload.mjs prints it). Optional: without it every
# file comes from the site. Never put the service-role key here or in any file.
VITE_ASSET_BASE=
