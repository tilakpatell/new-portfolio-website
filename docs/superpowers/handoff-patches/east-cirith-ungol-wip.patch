+      expect(listen(r)).toEqual(r.order.slice(0, round));
+      for (let i = 0; i < round; i++) results.push(recall(r, r.order[i]));
+      for (let i = 0; i < 100 && r.phase === 'next'; i++) stepRecall(r, 0.05);
