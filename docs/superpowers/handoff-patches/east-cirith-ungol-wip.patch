+    const r = newRecall(4);
+    expect(recall(r, r.order[0])).toBeNull();
+    stepRecall(r, RECALL.wait + 0.1);
+    expect(telling(r)).toBe(r.order[0]);
+    stepRecall(r, RECALL.show);
+    expect(telling(r)).toBeNull();
+    const told = [r.order[0], ...listen(r)];
