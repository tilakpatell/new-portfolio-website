# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
scripts/.cache/

# local only: this machine's preview servers, patch leftovers, and the
# contact sheets the model scripts write for looking over
.claude/launch.json
*.orig
lab/*
# (but the universe map's baseline, which every visual change measures against: scripts/universe-check.mjs)
!lab/universe/
lab/universe/*
!lab/universe/baseline/
# (and the galaxy surfaces' per-level baselines: scripts/galaxy-check.mjs BUDGET=1)
!lab/baseline/

# superpowers brainstorming companion session files
.superpowers
# the harmonium's source recording (build-harmonium.py downloads it)
scripts/data/harmonium/
.claude/worktrees/

# what scripts/voices makes along the way (the lines it makes, in
# public/audio/voiced, are published with the site)
scripts/voices/cache/
scripts/voices/refs/
scripts/voices/lines.json
scripts/voices/**/__pycache__/
.scratch/

# what scripts/gen3d makes along the way (raw GLBs, concept images, renders)
scripts/gen3d/cache/
scripts/motion/cache/
scripts/motion/__pycache__/
# what the AI tests leave to look at: the render tier's PNGs, the nightly's results (CI keeps them as artifacts)
scripts/ai-e2e/render/out/
scripts/ai-e2e/results/

# the parity check's pictures (scripts/gpu-parity.mjs): the pull request carries the numbers
scripts/gpu-parity/out/
# (and the front door's payload, before and after: scripts/payload-check.mjs)
!lab/payload/

# keys stay out (supabase/README.md)
.env.local
.env.*.local

